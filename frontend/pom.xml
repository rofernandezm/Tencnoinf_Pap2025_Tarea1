<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>turismouy.FrontEnd</groupId>
  <artifactId>turismouy.UI</artifactId>
  <version>1.0.0</version>
  <packaging>war</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <jakarta.servlet.version>6.0.0</jakarta.servlet.version>
    <jakarta.servlet.jsp.version>3.1.0</jakarta.servlet.jsp.version>
    <jakarta.el.version>5.0.0</jakarta.el.version>
    <eclipselink.version>4.0.4</eclipselink.version>
    <jakarta.persistence.version>3.1.0</jakarta.persistence.version>
    <hsqldb.version>2.7.2</hsqldb.version>
    <jakarta.servlet.jstl.api.version>3.0.0</jakarta.servlet.jstl.api.version>
    <jakarta.servlet.jstl.version>3.0.1</jakarta.servlet.jstl.version>
    <maven.javadoc.version>3.6.3</maven.javadoc.version>
    <maven.war.version>3.4.0</maven.war.version>
  </properties>

  <dependencies>
    <!-- Backend: 'mvn install' en Backend -->
    <dependency>
      <groupId>turismouy.Backend</groupId>
      <artifactId>turismouy.Backend</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>${jakarta.servlet.version}</version>
      <scope>provided</scope>
    </dependency>
    
    <!-- Jakarta Servlet JSP API: necesario para compilar archivos JSP -->
    <dependency>
      <groupId>jakarta.servlet.jsp</groupId>
      <artifactId>jakarta.servlet.jsp-api</artifactId>
      <version>${jakarta.servlet.jsp.version}</version>
      <scope>provided</scope>
    </dependency>
    
    <!-- Jakarta Expression Language API: para sintaxis EL en JSP -->
    <dependency>
      <groupId>jakarta.el</groupId>
      <artifactId>jakarta.el-api</artifactId>
      <version>${jakarta.el.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Si la UI accede a JPA directamente (opcional, suele bastar con lo que exporta Backend) -->
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <version>${jakarta.persistence.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.persistence</groupId>
      <artifactId>eclipselink</artifactId>
      <version>${eclipselink.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Driver HSQLDB: server/lib -->
    <dependency>
      <groupId>org.hsqldb</groupId>
      <artifactId>hsqldb</artifactId>
      <version>${hsqldb.version}</version>
      <scope>provided</scope>
    </dependency>
    
    <dependency>
      <groupId>jakarta.servlet.jsp.jstl</groupId>
      <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
      <version>${jakarta.servlet.jstl.api.version}</version>
    </dependency>
    
    <dependency>
      <groupId>org.glassfish.web</groupId>
      <artifactId>jakarta.servlet.jsp.jstl</artifactId>
      <version>${jakarta.servlet.jstl.version}</version>
    </dependency>
    
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-war-plugin</artifactId>
        <version>${maven.war.version}</version>
        <configuration>
          <warName>turismouy.UI</warName>
          <!-- Si no tenés web.xml clásico, evita warnings -->
          <failOnMissingWebXml>false</failOnMissingWebXml>
        </configuration>
      </plugin>
      
      <!-- Plugin para generar Javadoc -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>${maven.javadoc.version}</version>
        <configuration>
        <skip>true</skip>
          <source>17</source>
          <show>private</show>
          <encoding>UTF-8</encoding>
          <docencoding>UTF-8</docencoding>
          <charset>UTF-8</charset>
          <locale>es_ES</locale>
          <windowtitle>TurismoUY Frontend - Documentación API</windowtitle>
          <doctitle>TurismoUY Frontend - Capa de Presentación Web</doctitle>
          <header><![CDATA[<b>TurismoUY Frontend v1.0.0</b>]]></header>
          <footer><![CDATA[<b>Equipo TurismoUY - 2025</b>]]></footer>
          <bottom><![CDATA[<i>Documentación generada para el proyecto TurismoUY - Tarea 1 PAP 2025</i>]]></bottom>
          <detectJavaApiLink>true</detectJavaApiLink>
          <detectLinks>true</detectLinks>
          <linksource>true</linksource>
          <nohelp>false</nohelp>
          <author>true</author>
          <version>true</version>
          <use>true</use>
          <additionalOptions>-Xdoclint:none</additionalOptions>
          <additionalJOptions>
            <additionalJOption>-J-Duser.language=es</additionalJOption>
            <additionalJOption>-J-Duser.country=ES</additionalJOption>
          </additionalJOptions>
          <tags>
            <tag>
              <name>apiNote</name>
              <placement>a</placement>
              <head>Nota de API:</head>
            </tag>
            <tag>
              <name>implSpec</name>
              <placement>a</placement>
              <head>Especificación de Implementación:</head>
            </tag>
            <tag>
              <name>implNote</name>
              <placement>a</placement>
              <head>Nota de Implementación:</head>
            </tag>
          </tags>
    	  <doclint>none</doclint>
    	  <failOnError>false</failOnError>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

