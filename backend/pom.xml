<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <groupId>turismouy.Backend</groupId>
  <artifactId>turismouy.Backend</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <eclipselink.version>4.0.4</eclipselink.version>
    <exec-maven-plugin.version>3.1.0</exec-maven-plugin.version>
    <hsqldb.version>2.7.2</hsqldb.version>
    <jakarta.persistence.version>3.1.0</jakarta.persistence.version>
    <jakarta.xml.bind.version>4.0.2</jakarta.xml.bind.version>
    <jax-ws.version>4.0.3</jax-ws.version>
    <jaxb.runtime.version>4.0.5</jaxb.runtime.version>
    <maven-compiler-plugin.version>3.11.0</maven-compiler-plugin.version>
    <maven-shade-plugin.version>3.5.1</maven-shade-plugin.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <tomcat-catalina.version>11.0.11</tomcat-catalina.version>
  </properties>

  <dependencies>
    <!-- EclipseLink JPA sin MOXy -->
    <dependency>
      <groupId>org.eclipse.persistence</groupId>
      <artifactId>org.eclipse.persistence.jpa</artifactId>
      <version>${eclipselink.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.eclipse.persistence</groupId>
          <artifactId>org.eclipse.persistence.moxy</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <version>${jakarta.persistence.version}</version>
    </dependency>

    <!-- Driver HSQLDB -->
    <dependency>
      <groupId>org.hsqldb</groupId>
      <artifactId>hsqldb</artifactId>
      <version>${hsqldb.version}</version>
    </dependency>

    <!-- Tomcat APIs (solo si alguna clase las referencia) -->
    <dependency>
      <groupId>org.apache.tomcat</groupId>
      <artifactId>tomcat-catalina</artifactId>
      <version>${tomcat-catalina.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Metro JAX-WS runtime (Jakarta) -->
    <dependency>
      <groupId>com.sun.xml.ws</groupId>
      <artifactId>jaxws-rt</artifactId>
      <version>${jax-ws.version}</version>
    </dependency>

    <!-- JAXB API (Jakarta) -->
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>${jakarta.xml.bind.version}</version>
    </dependency>

    <!-- JAXB RI runtime (implementación oficial) -->
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>${jaxb.runtime.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Compilador -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
          <encoding>${project.build.sourceEncoding}</encoding>
        </configuration>
      </plugin>

      <!-- JAR ejecutable (opcional) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven-shade-plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <filters>
                <!-- Excluir MOXy del uber-jar si se sombrea -->
                <filter>
                  <artifact>org.eclipse.persistence:eclipselink</artifact>
                  <excludes>
                    <exclude>org/eclipse/persistence/jaxb/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>desktop.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>run-publisher</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven-plugin.version}</version>
            <configuration>
              <mainClass>turismouyapp.webservices.Publisher</mainClass>
              <classpathScope>runtime</classpathScope>
              <systemProperties>
                <!-- Forzar JAXB-RI (para Metro y para cualquier JAXBContext) -->
                <systemProperty>
                  <key>com.sun.xml.ws.spi.db.BindingContextFactory</key>
                  <value>com.sun.xml.ws.db.glassfish.JAXBRIContextFactory</value>
                </systemProperty>
                <systemProperty>
                  <key>jakarta.xml.bind.JAXBContextFactory</key>
                  <value>org.glassfish.jaxb.runtime.v2.ContextFactory</value>
                </systemProperty>
                <!-- Dump de SOAP para debug -->
                <systemProperty>
                  <key>com.sun.xml.ws.transport.http.HttpAdapter.dump</key>
                  <value>true</value>
                </systemProperty>
              </systemProperties>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>run-desktop</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven-plugin.version}</version>
            <configuration>
              <mainClass>desktop.Main</mainClass>
              <classpathScope>runtime</classpathScope>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>