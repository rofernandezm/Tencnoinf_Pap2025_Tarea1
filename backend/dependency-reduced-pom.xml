<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>turismouy.Backend</groupId>
  <artifactId>turismouy.Backend</artifactId>
  <version>1.0.0</version>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <filters>
                <filter>
                  <artifact>org.eclipse.persistence:eclipselink</artifact>
                  <excludes>
                    <exclude>org/eclipse/persistence/jaxb/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer>
                  <mainClass>desktop.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <show>protected</show>
          <source>17</source>
          <encoding>UTF-8</encoding>
          <charset>UTF-8</charset>
          <docencoding>UTF-8</docencoding>
          <windowtitle>TurismoUY Backend API</windowtitle>
          <doctitle>&lt;h1&gt;TurismoUY - Backend API Documentation&lt;/h1&gt;</doctitle>
          <bottom>&lt;i&gt;© 2025 TurismoUY Team&lt;/i&gt;</bottom>
          <additionalOptions>
            <additionalOption>-html5</additionalOption>
          </additionalOptions>
          <doclint>none</doclint>
          <failOnError>false</failOnError>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>run-publisher</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven-plugin.version}</version>
            <configuration>
              <mainClass>turismouyapp.webservices.Publisher</mainClass>
              <classpathScope>runtime</classpathScope>
              <systemProperties>
                <systemProperty>
                  <key>com.sun.xml.ws.spi.db.BindingContextFactory</key>
                  <value>com.sun.xml.ws.db.glassfish.JAXBRIContextFactory</value>
                </systemProperty>
                <systemProperty>
                  <key>jakarta.xml.bind.JAXBContextFactory</key>
                  <value>org.glassfish.jaxb.runtime.v2.ContextFactory</value>
                </systemProperty>
                <systemProperty>
                  <key>com.sun.xml.ws.transport.http.HttpAdapter.dump</key>
                  <value>true</value>
                </systemProperty>
              </systemProperties>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>run-desktop</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven-plugin.version}</version>
            <configuration>
              <mainClass>desktop.Main</mainClass>
              <classpathScope>runtime</classpathScope>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <dependencies>
    <dependency>
      <groupId>org.apache.tomcat</groupId>
      <artifactId>tomcat-catalina</artifactId>
      <version>11.0.11</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <properties>
    <tomcat-catalina.version>11.0.11</tomcat-catalina.version>
    <jakarta.xml.bind.version>4.0.2</jakarta.xml.bind.version>
    <jakarta.persistence.version>3.1.0</jakarta.persistence.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <hsqldb.version>2.7.2</hsqldb.version>
    <eclipselink.version>4.0.4</eclipselink.version>
    <maven.compiler.target>17</maven.compiler.target>
    <jax-ws.version>4.0.3</jax-ws.version>
    <jaxb.runtime.version>4.0.5</jaxb.runtime.version>
    <exec-maven-plugin.version>3.1.0</exec-maven-plugin.version>
  </properties>
</project>
